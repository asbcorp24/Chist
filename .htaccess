<IfModule mod_rewrite.c>
    RewriteEngine On

    # Let Let's Encrypt / ACME checks pass through unchanged.
    RewriteRule ^\.well-known(?:/|$) - [L]

    # Never rewrite requests already addressed to public/.
    RewriteRule ^public(?:/|$) - [L]

    # Serve existing public files/directories (CSS, JS, images, PWA assets)
    # without exposing the Laravel project root.
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.+)$ public/$1 [L]

    # All application URLs are handled by Laravel's front controller.
    # PATH_INFO keeps routes such as /schedule, /login and /dashboard intact.
    RewriteRule ^$ public/index.php [L,QSA]
    RewriteRule ^(.+)$ public/index.php/$1 [L,QSA]
</IfModule>

# Block sensitive project files when the repository itself is the Timeweb web root.
<FilesMatch "^(\.env|\.env\..*|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|README\.md)$">
    Require all denied
</FilesMatch>

Options -Indexes
